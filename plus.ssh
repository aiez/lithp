## plus.ssh -- a2ps style for the plus lisp dialect.
##
## Use:  a2ps --pretty-print=plus plus.lisp -o out.ps
## (the Makefile pdf rule wires this up automatically)
##
## Inherits Common Lisp (clisp.ssh) and adds the plus
## reader macros ($field, @key) and +-macros.

style plus is
written by "Tim Menzies <timm@ieee.org>"
version is 0.1
requires a2ps 4.12i

documentation is
  "Common Lisp plus the plus.lisp/fft.lisp macros: plus,"
  "plus+, new+, defread, defeg, if+, f+/ff+/fff+, for+,"
  "let+, has, ?, ??, and the $field / @key readers."
end documentation

ancestors are
  clisp
end ancestors

keywords in Keyword_strong are
  plus, "plus+", "new+", defread, defeg,
  "if+", "f+", "ff+", "fff+", "for+", "let+",
  has, "?", "??", "!", acc
end keywords

# (plus NAME ...), (plus+ NAME ...), (defread NAME ...):
# mark NAME as a label, like (defun NAME ...).
sequences are
  (/\\(/
   /(plus\\+?|defread|defeg)/
   /([ \t]+)/
    "(" Plain, \1 Keyword_strong, \2 Plain) Label_strong /[)[:space:]]/ Plain
end sequences

# $field  and  @key  reader-macro shortcuts
operators are
  /\$[A-Za-z][A-Za-z0-9_-]*/ Label_strong,
  /@[A-Za-z][A-Za-z0-9_-]*/ Label_strong
end operators

end style
